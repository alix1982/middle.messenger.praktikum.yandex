{
    "compilerOptions": {
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "target": "es2020",
        "moduleResolution": "node",
        "module": "ESNext",
        "allowSyntheticDefaultImports": true,
        "lib": ["es2020", "dom"]
    },
    "include": [
        "src/**/*.ts",
        "declaration.d.ts",
        "src/**/*.spec.ts"
    ]
}
